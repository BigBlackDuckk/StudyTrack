# Porta da API
PORT=3333

# ---------------------------------------------------------------------------
# Banco de dados — escolha UM dos modos abaixo.
# ---------------------------------------------------------------------------

# Modo 1 (padrão): SQLite local — não precisa configurar nada.
# DATABASE_FILE="./database/studytrack.db"

# Modo 2: MySQL (ex.: MySQL Workbench + MySQL Server rodando em localhost).
# Basta definir MYSQL_HOST (ou DB_CLIENT=mysql) que o servidor usa MySQL.
DB_CLIENT=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=sua_senha_aqui
MYSQL_DATABASE=studytrack
# Alternativa com uma única URL:
# MYSQL_URL="mysql://root:sua_senha_aqui@localhost:3306/studytrack"

